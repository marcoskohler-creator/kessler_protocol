{
  "kessler-risk-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|view_file|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/entry.py --harness antigravity --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "kessler-evidence-engine": {
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|view_file|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/entry.py --harness antigravity --event PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ./scripts/entry.py --harness antigravity --event Stop",
        "timeout": 10
      }
    ]
  }
}
